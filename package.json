{
  "name": "@anh-ld/kinu-styles",
  "version": "0.2.0",
  "description": "CSS themes for kinu.",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "lib"
  ],
  "exports": {
    "./*.css": "./lib/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "(bun run gen && bun build --watch portal/index.html --outdir dist) & bun --hot serve.ts",
    "gen": "bun build.ts --gen",
    "build:lib": "bun build.ts",
    "build:portal": "rm -rf dist && bun build portal/index.html --outdir dist",
    "build": "bun run build:lib && bun run build:portal"
  },
  "keywords": [
    "kinu",
    "preact",
    "css",
    "themes",
    "daisyui",
    "design-trends"
  ],
  "engines": {
    "bun": ">=1"
  },
  "devDependencies": {
    "kinu": "0.1.4",
    "preact": "10.29.8"
  }
}
